<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELA | Admin Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include ('../partials/header') %>

    <main class= "admin-page">

        <section class= "admin-header">
            <h1>VELA Product Management</h1>
            <p>Manage products available in the VELA store.</p>
        </section>

        <section class="admin-card">
            <h2>Add New Product</h2>

            <form action="/admin/add" method="POST">

                <input
                    type="text"
                    name="name"
                    placeholder="Product Name"
                    required>

                <input
                    type="text"
                    name="category"
                    placeholder="Category"
                    required>

                <input
                    type="number"
                    step="0.01"
                    name="price"
                    placeholder="Price"
                    required>

                <input
                    type="text"
                    name="image"
                    placeholder="Image Path (tops/example.png)"
                    required>

                <textarea
                    name="description"
                    placeholder="Product Description"
                    required>
                </textarea>

                <button type="submit" class="shop-button">ADD PRODUCT</button>

            </form>
        </section>

        <section class="admin-card">
            <h2>Current Products</h2>

            <% products.forEach(product => { %>

                <div class="admin-product">
                    <div>
                        <h3><%= product.name %></h3>

                        <p>Category:<%= product.category %></p>

                        <p>Price:$<%= product.price.toFixed(2) %></p>
                    </div>

                    <div class="admin-actions">

                        <form action="/admin/delete/<%= product.id %>" method="POST">
                        
                            <button type="submit" class="remove-item-button">Delete</button>
                        </form>
                    </div>
                </div>

            <% }) %>

        </section>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>