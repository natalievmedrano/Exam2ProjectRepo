
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | VELA</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('../partials/header') %>

    <main class="shop-page">

        <% if (search) { %>
            <section class="shop-heading">
                <h1>Search Results</h1>
                <p>Showing results for "<%= search %>"</p>
            </section>
        <%} %>

        <section class="shop-heading">
           

            <% if (selectedCategory === 'bottoms') { %>
                <h1>Our Pants Collection</h1>
                <p>Find the perfect pant for your elegant outfits.</p>

            <% } else if (selectedCategory === 'tops') { %>
                <h1>Our Tops Collection</h1>
                <p>Discover your next favorite tops.</p>

            <% } else if (selectedCategory === 'shoes') {
            %>
                <h1>Your next favorite pair of shoes</h1>
                <p>Find a shoe that feels like YOU.</p>
            
                <% } else if (selectedCategory === 'accessories') {%>
                        <h1>The perfect finishing touch</h1>
                        <p>Find the perfect accesory to complete your VELA look.</p>
               <% } %>
               
                    </section>

        <section class="product-grid">

            <% if (products.length === 0) { %>
                <p class="no-results">
                    No products with that name were found. Try again.
                </p>

            <%} else { %>
                <% products.forEach(product => { %>

                <article class="product-card">

                    <img
                        src="/images/<%= product.image %>"
                        alt="<%= product.name %>"
                        class="product-image"
                    >

                    <div class="product-info">
                        <h3><%= product.name %></h3>

                        <a href="/product/<%= product.id %>" class="view-product">
                            VIEW PRODUCT
                        </a>
                    </div>

                </article>

            <% }); %>
           <% } %>

            

        </section>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>
